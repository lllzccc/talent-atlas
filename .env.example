# Local mode persists to data/store.json. Set PostgreSQL to use database persistence.
DATABASE_URL=
# Required when exposing API outside localhost. Requests use Authorization: Bearer TOKEN.
APP_ACCESS_TOKEN=
# Optional 32-byte hex key for encrypting saved AI credentials; local mode creates a private key file.
AI_ENCRYPTION_KEY=

# Demo deployment: leave DATABASE_URL and APP_ACCESS_TOKEN empty.
# The current demo loads synthetic data through the bundled demo API route.
